# Application Settings
APP_NAME=AI_Study_Assistant
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Database Configuration (MySQL / XAMPP)
DATABASE_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=study_assistant
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_PASSWORD

# Model Paths
CLASSIFICATION_MODEL_PATH=models/question_classifier.pt
CLASSIFICATION_VECTORIZER_PATH=models/tfidf_vectorizer.pkl
CLASSIFICATION_LABEL_ENCODER_PATH=models/label_encoder.pkl

# Security & API Keys
SECRET_KEY=insecure-default-change-me-in-production-random-secret-key-32chars
API_RATE_LIMIT=60/minute

# Optional: LLM Providers (free/local options used by default)
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=
